      objectReference: {fileID: 0}
    - target: {fileID: 8013036933943373306, guid: 8201391c6058abe4bba52a2a92b88108, type: 3}
      propertyPath: m_text
      value: "The ball can't get any momentum without a slope. \nThis time, add the
        ConstantForce component to it and set a force in the direction of the goal
        (look at the directional gizmo top right corner of the scene view to find
        in which axis and direction the force should be applied). \nThe component
        requires a Rigidbody to work and will add one automatically.\n"
      objectReference: {fileID: 0}
